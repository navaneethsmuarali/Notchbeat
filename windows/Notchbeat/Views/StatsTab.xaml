<UserControl x:Class="Notchbeat.Views.StatsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="400"
             Foreground="White">
    <Grid Margin="16,8,16,12">
        <StackPanel>
            <!-- CPU Row -->
            <Border Background="#10FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚡ CPU" FontSize="12" FontWeight="SemiBold"/>
                    <ProgressBar Grid.Column="1" Value="{Binding Stats.CpuUsage}" Maximum="1" Height="6" Margin="16,0" Background="#20FFFFFF" Foreground="#34C759"/>
                    <TextBlock Grid.Column="2" Text="{Binding Stats.CpuUsage, StringFormat='{}{0:P0}'}" FontSize="12" FontWeight="Bold"/>
                </Grid>
            </Border>

            <!-- Memory Row -->
            <Border Background="#10FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🧠 RAM" FontSize="12" FontWeight="SemiBold"/>
                    <ProgressBar Grid.Column="1" Value="{Binding Stats.MemFraction}" Maximum="1" Height="6" Margin="16,0" Background="#20FFFFFF" Foreground="#007AFF"/>
                    <TextBlock Grid.Column="2" Text="{Binding Stats.MemFraction, StringFormat='{}{0:P0}'}" FontSize="12" FontWeight="Bold"/>
                </Grid>
            </Border>

            <!-- Network Row -->
            <Border Background="#10FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🌐 Network" FontSize="12" FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Stats.NetIn, StringFormat='{}↓ {0:N0} B/s'}" FontSize="11" Foreground="#8CFFFFFF" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Stats.NetOut, StringFormat='{}↑ {0:N0} B/s'}" FontSize="11" Foreground="#8CFFFFFF"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Battery Row -->
            <Border Background="#10FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔋 Battery" FontSize="12" FontWeight="SemiBold"/>
                    <ProgressBar Grid.Column="1" Value="{Binding Stats.Battery}" Maximum="100" Height="6" Margin="16,0" Background="#20FFFFFF" Foreground="#34C759"/>
                    <TextBlock Grid.Column="2" Text="{Binding Stats.Battery, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

