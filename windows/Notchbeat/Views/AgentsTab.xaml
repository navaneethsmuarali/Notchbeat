<UserControl x:Class="Notchbeat.Views.AgentsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="400"
             Foreground="White">
    <Grid Margin="16,8,16,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Agents.Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="36" Margin="0,0,0,6" Background="#10FFFFFF" CornerRadius="8" Padding="10,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="✨" FontSize="12" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Project}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#8CFFFFFF" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="10" FontWeight="SemiBold" Foreground="#FF9F0A" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <TextBlock Text="No active Claude Code or Codex sessions"
                   FontSize="12" Foreground="#59FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Agents.Sessions.Count, Converter={StaticResource InverseBoolToVisibility}}"/>
    </Grid>
</UserControl>

