<Window x:Class="Notchbeat.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Notchbeat Settings"
        Height="450" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="White"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Notchbeat Settings" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

            <!-- Appearance -->
            <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="Bold" Foreground="#8CFFFFFF" Margin="0,8,0,4"/>
            <CheckBox Content="Glass Finish (semi-transparent blur)" IsChecked="False" Margin="0,4" Foreground="White"/>
            <CheckBox Content="Show App Switcher Bubbles" IsChecked="{Binding ShowBubbles}" Margin="0,4" Foreground="White"/>

            <!-- Features -->
            <TextBlock Text="FEATURES" FontSize="11" FontWeight="Bold" Foreground="#8CFFFFFF" Margin="0,12,0,4"/>
            <CheckBox Content="Enable Clipboard History (up to 60 items)" IsChecked="{Binding ClipboardEnabled}" Margin="0,4" Foreground="White"/>
            <CheckBox Content="Show Bluetooth device connection alerts" IsChecked="{Binding DeviceAlerts}" Margin="0,4" Foreground="White"/>
            <CheckBox Content="Monitor Claude Code / Codex terminal sessions" IsChecked="{Binding AgentsEnabled}" Margin="0,4" Foreground="White"/>

            <!-- System -->
            <TextBlock Text="SYSTEM" FontSize="11" FontWeight="Bold" Foreground="#8CFFFFFF" Margin="0,12,0,4"/>
            <CheckBox Content="Launch Notchbeat automatically at Windows login" IsChecked="{Binding LaunchAtLogin}" Margin="0,4" Foreground="White"/>

            <Button Content="Close" HorizontalAlignment="Right" Width="80" Height="28" Margin="0,20,0,0" Style="{StaticResource PillButtonStyle}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>

