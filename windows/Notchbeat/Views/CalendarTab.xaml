<UserControl x:Class="Notchbeat.Views.CalendarTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="400"
             Foreground="White">
    <Grid Margin="16,8,16,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Calendar.Events}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="36" Margin="0,0,0,6" Background="#10FFFFFF" CornerRadius="8" Padding="10,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="{Binding ColorBrush}" CornerRadius="2" VerticalAlignment="Stretch"/>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Start, StringFormat='{}{0:h:mm tt}'}" FontSize="10" Foreground="#8CFFFFFF"/>
                                </StackPanel>

                                <Button Grid.Column="3" Content="Join" Margin="8,0,0,0" Padding="12,3" FontSize="11" FontWeight="SemiBold"
                                        Style="{StaticResource PillButtonStyle}" Background="#34C759" Foreground="Black"
                                        Visibility="{Binding JoinUrl, Converter={StaticResource NullToVisibility}}"
                                        Click="Join_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

