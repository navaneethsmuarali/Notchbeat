<UserControl x:Class="Notchbeat.Views.ClipboardTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="400"
             Foreground="White">
    <Grid Margin="16,8,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Clips.Clips}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="32" Margin="0,0,0,4" Background="#10FFFFFF" CornerRadius="6" Padding="8,4" Cursor="Hand" MouseLeftButtonDown="Clip_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="📋" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Preview}" FontSize="12" Foreground="#D9FFFFFF" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding Date, StringFormat='{}{0:HH:mm}'}" FontSize="10" Foreground="#59FFFFFF" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <TextBlock Text="No items in clipboard history yet"
                   FontSize="12" Foreground="#59FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Clips.Clips.Count, Converter={StaticResource InverseBoolToVisibility}}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Clear History" Click="Clear_Click" Style="{StaticResource SmallButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>

