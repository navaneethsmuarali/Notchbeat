<UserControl x:Class="Notchbeat.Views.MusicTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="400"
             Foreground="White">
    <Grid Margin="16,8,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Song info & artwork -->
        <Grid Grid.Row="0" Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="64" Height="64" CornerRadius="8" Background="#333333" ClipToBounds="True">
                <Image Source="{Binding Player.Artwork}" Stretch="UniformToFill"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,6,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Player.Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Player.Artist}" FontSize="13" Foreground="#8CFFFFFF" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- Progress bar & timestamps -->
        <StackPanel Grid.Row="1" Margin="0,4,0,8">
            <Slider Value="{Binding Player.Position.TotalSeconds, Mode=OneWay}"
                    Maximum="{Binding Player.Duration.TotalSeconds}"
                    IsMoveToPointEnabled="True"
                    Thumb.DragCompleted="Slider_DragCompleted"
                    Height="18"/>
            <Grid Margin="2,-2,2,0">
                <TextBlock Text="{Binding Player.Position, Converter={StaticResource TimeSpanToString}}" FontSize="10" Foreground="#59FFFFFF" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding Player.Duration, Converter={StaticResource TimeSpanToString}}" FontSize="10" Foreground="#59FFFFFF" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- Transport controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Content="⏮" Width="36" Height="36" FontSize="14" Click="Prev_Click" Style="{StaticResource SmallButtonStyle}" Margin="8,0"/>
            <Button Content="{Binding Player.IsPlaying, Converter={x:Null}}" x:Name="PlayPauseBtn" Width="44" Height="44" FontSize="18" Click="PlayPause_Click" Style="{StaticResource PillButtonStyle}" Margin="8,0"/>
            <Button Content="⏭" Width="36" Height="36" FontSize="14" Click="Next_Click" Style="{StaticResource SmallButtonStyle}" Margin="8,0"/>
        </StackPanel>
    </Grid>
</UserControl>

